# Copy this file to .env. Never commit the real .env file.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/pdf_study_assistant
SESSION_SECRET=replace-this-with-at-least-32-random-characters
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_MB=15
VITE_MAX_UPLOAD_MB=15
MAX_PDF_PAGES=300

# Offline development defaults: lexical vectors + evidence-only quoted passages.
# These are not neural embeddings or generated LLM responses.
EMBEDDING_PROVIDER=local-hash
CHAT_PROVIDER=extractive

# Optional OpenAI-compatible chat and embedding APIs. They can use different
# providers/base URLs. Configure exact model IDs supported by your chosen API.
# Do not assume a provider's free tier, quota, or data-retention behavior.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
AI_REQUEST_TIMEOUT_MS=30000

RAG_TOP_K=5
RAG_MAX_CANDIDATES=5000
RAG_MIN_SCORE=0.08
