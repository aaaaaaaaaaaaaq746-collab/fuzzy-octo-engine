{
  "name": "ai-pdf-study-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm test --workspace server",
    "lint": "npm run lint --workspace server && npm run lint --workspace client",
    "start": "npm start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
